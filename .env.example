# Copia este archivo como .env.local y completa los valores de TU proyecto Supabase.
# Nunca subas .env.local a GitHub (ya está en .gitignore).

# ── Variables públicas (diseñadas para exponerse en el navegador) ──
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# (en proyectos antiguos puedes usar la "anon public key")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública de la aplicación (para copiar enlaces de revistas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Variables privadas (SOLO servidor; en Vercel NO deben empezar con NEXT_PUBLIC_) ──
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...)
# (en proyectos antiguos: "service_role key"). Da acceso total: mantenla en secreto.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Dominio interno para los correos sintéticos de las cuentas sin correo personal.
# ".invalid" está reservado (RFC 2606): nunca se entregan mensajes.
STUDENT_EMAIL_DOMAIN=alumnos.revista-escolar.invalid

# Texto aleatorio largo para anonimizar (hash) las IP del registro de intentos de acceso.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOGIN_HASH_SALT=cambia-esto-por-un-valor-aleatorio
